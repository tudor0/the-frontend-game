# URL-ul API-ului backend
# Development (local): http://localhost:3001/api
# Production: https://your-api-domain.com/api
VITE_API_URL=http://localhost:3001/api

# Google OAuth Client ID (opțional - doar dacă vrei login cu Google)
# Trebuie să fie același cu cel din server/.env
# Obține de la: https://console.cloud.google.com/
VITE_GOOGLE_CLIENT_ID="your_google_client_id_here"
