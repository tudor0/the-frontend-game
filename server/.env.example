# Conexiune la baza de date PostgreSQL
# Pentru Docker (default): postgresql://user:password@localhost:5432/gamedb
# Pentru PostgreSQL local: ajustează user, password și database name
DATABASE_URL="postgresql://user:password@localhost:5432/gamedb"

# Secrete pentru JWT - SCHIMBĂ-LE CU VALORI ALEATORII UNICE!
# Generează cu: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET="your_access_token_secret_here_change_this_to_random_string"
REFRESH_TOKEN_SECRET="your_refresh_token_secret_here_change_this_to_random_string"

# Google OAuth Client ID (opțional - doar dacă vrei login cu Google)
# Obține de la: https://console.cloud.google.com/
GOOGLE_CLIENT_ID="your_google_client_id_here"

# Mediu de rulare
NODE_ENV="development"
